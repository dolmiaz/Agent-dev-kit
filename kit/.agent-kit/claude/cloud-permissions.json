{
  "_comment": "Claude Code on the web でだけ使う判定(PreToolUse hook: pretool.py)。ローカルでは使われない。allow は pretool.py のホワイトリスト(コマンド・サブコマンド・オプションを明示)で決める。ここには追加の ask / deny と、秘密ファイルの名前を書く。パターンは fnmatch で、引用符を外した語を空白でつないだ文字列に当てる。deny > ask > allow。",
  "ask": [
    "gh pr merge*",
    "gh release*",
    "gh repo*",
    "gh secret*",
    "gh variable*",
    "gh auth*",
    "gh ssh-key*",
    "gh gpg-key*",
    "npm publish*",
    "pnpm publish*",
    "yarn npm publish*",
    "cargo publish*",
    "uv publish*",
    "poetry publish*",
    "twine upload*",
    "gem push*",
    "docker push*",
    "docker login*",
    "vercel*",
    "netlify*",
    "fly *",
    "flyctl *",
    "wrangler*",
    "firebase deploy*",
    "terraform apply*",
    "terraform destroy*",
    "kubectl apply*",
    "kubectl delete*",
    "aws *",
    "gcloud *",
    "az *",
    "stripe *",
    "ssh-keygen*",
    "curl * -X POST*",
    "curl * --data*",
    "curl * -d *"
  ],
  "deny": [
    "git filter-repo*",
    "git filter-branch*",
    "git update-ref -d*",
    "git reset --hard origin/*",
    "rm -rf /",
    "rm -rf /*",
    "rm -rf ~*",
    "rm -rf .git*",
    "rm -rf $HOME*"
  ],
  "deny_read": [
    ".env",
    ".env.*",
    ".envrc",
    "*.pem",
    "*.p12",
    "*.key",
    "id_rsa*",
    "id_ed25519*",
    "secrets",
    "secrets/*",
    ".netrc",
    ".git-credentials",
    "credentials*",
    "hosts.yml",
    ".npmrc",
    ".pypirc"
  ]
}
