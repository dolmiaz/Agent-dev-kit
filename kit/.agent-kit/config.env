# .agent-kit/config.env — リポジトリに置く設定(秘密を書かない。コミットされる)。
# 優先順位: 環境変数 > このファイル > 各スクリプトの既定値。
# 読むのは AGENT_ で始まる KEY=value の行だけ(コードは実行しない)。

# --- 依存の導入 ---
# 各段の制限時間(秒)。失敗したら止めるか(0=記録して続ける / 1=終了コード1)
AGENT_STEP_TIMEOUT=600
AGENT_SETUP_STRICT=0
# Playwright のブラウザ: auto(依存に playwright があれば入れる) / 1(常に) / 0(入れない)
AGENT_PLAYWRIGHT=auto
AGENT_PLAYWRIGHT_BROWSERS=chromium
# docker compose のイメージを先に pull する(Claude Code on the web でのみ意味がある)
AGENT_DOCKER_PULL=0
# Gradle/Maven の依存を先に取得する(重い)
AGENT_JVM_WARMUP=0
# ロックファイルが無い package.json でも npm install する(ロックは作らない)
AGENT_NODE_ALLOW_NO_LOCK=0

# --- コミットの作者(クラウドのエージェントを区別する。リポジトリ単位。認証・署名とは別) ---
# 公開版の値は例。自分の値は install.py --profile <個人設定> で入れる(キットの公開版に個人の値を書かない)
AGENT_GIT_IDENTITY=1
AGENT_GIT_NAME_CLAUDE="Claude Code (cloud)"
AGENT_GIT_EMAIL_CLAUDE="claude-cloud@example.com"
AGENT_GIT_NAME_CODEX="Codex (cloud)"
AGENT_GIT_EMAIL_CODEX="codex-cloud@example.com"

# --- 作業ログ ---
# 未送信ログの置き場: outbox(既定。リポジトリの外、Git に入らない) / repo(.agent-logs/pending/、コミットできる)
# repo は「非公開リポジトリで、ログを Git に残すと決めた」場合だけ使う。
AGENT_LOG_PENDING_MODE=outbox
# 変更があったのに記録が無いとき、Stop hook で1回促す(Claude のみ)
AGENT_LOG_ENFORCE=1
# 送信に失敗したら終了コード1にする(既定0=作業を止めない)
AGENT_LOG_STRICT=0
# 送信のタイムアウト(秒)
AGENT_LOG_SYNC_TIMEOUT=20

# --- Claude Code on the web: クラウド内だけのコマンド許可判定(PreToolUse hook。ローカルでは何もしない) ---
# 1=通常の開発コマンドをクラウドでだけ自動許可 / 0=何もしない(UI で選んだモードに任せる)
AGENT_CLOUD_AUTO_ALLOW=1

# --- レビューとマージ可否 ---
AGENT_REVIEW_MODEL=claude-opus-5-5
# 必須 CI が1つも決まっていない(ルールセット・ブランチ保護・.agent-kit/ci-policy.json のどれにも無い)PR を通すか(0=通さない)
AGENT_ALLOW_NO_CI=0
# 判定に使う設定(AGENT_REVIEW_MODEL・AGENT_ALLOW_NO_CI・AGENT_REVIEWER_LOGINS)は、merge-gate がベースブランチの
# この ファイルを GitHub から読む(PR のブランチでの変更・環境変数は効かない)
# レビューの記録を受け付ける投稿者(GitHub ユーザー名、またはアプリなら app:<slug>。カンマ区切り。空なら全員)
AGENT_REVIEWER_LOGINS=

# --- Issue の担当確保 ---
# 確保の記録を置く ref(ブランチではないので CI は動かない)
AGENT_CLAIM_REF_PREFIX=refs/agent-claims
# この時間、確保・ブランチ・PR に動きが無ければ --takeover で引き継げる
AGENT_CLAIM_STALE_HOURS=24
# 同じ agent 名でも別のセッションからの --resume は、この時間動きが無いときだけ(稼働中の横取りを防ぐ)
AGENT_CLAIM_LEASE_MINUTES=60
# 確保中は hook が AGENT_CLAIM_LEASE_MINUTES の 1/3 ごとに裏で claim-renew --mine を呼んで時刻を更新する(0 で止める)
AGENT_CLAIM_RENEW=1

# --- 対外文章の推敲(Gemini)と公開(bin/agent-publish、docs/10) ---
# 1 = PR のタイトル・本文、リリースノート、README を含む push は、Gemini の推敲と作成側の確認を済ませた本文だけで公開する
# (Claude Code は PreToolUse で直接の公開を止める。Gemini が使えないときは公開だけが保留になる)。0 で推敲しない
AGENT_POLISH_REQUIRED=1
# 以下は本人が確かめてから、本人の手元の上書き(~/.config/agent-kit/publish.env。リポジトリの外)に書く。ここには書かない
#   AGENT_GEMINI_SEND_APPROVED=1        Gemini への送信を承認した(認証方式と、その利用条件の入力の扱いを確かめた)
#   AGENT_GEMINI_MODEL=<具体的なモデル名>  別名(auto・pro・flash)は使わない。推測で決めない
#   AGENT_GEMINI_AUTH=api-key|vertex|oauth
#   AGENT_GEMINI_KEY_ENV=GEMINI_API_KEY  api-key のとき、キーを入れた環境変数の名前(値は書かない)
#   AGENT_GEMINI_HOME=~/.local/state/agent-kit/gemini-home   推敲専用の Gemini の設定の置き場
#   AGENT_GEMINI_CLI_VERSION=<確かめた版>  違う版では動かさない
AGENT_GEMINI_TIMEOUT=180
AGENT_GEMINI_MAX_ATTEMPTS=3
AGENT_PUBLIC_DOC_GLOBS="README* */README* CHANGELOG* RELEASE_NOTES*"
