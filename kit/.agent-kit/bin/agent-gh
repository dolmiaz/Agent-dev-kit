#!/usr/bin/env python3
"""agent-gh — Issue から実装・レビュー・マージ可否判定までを、複数エージェントで二重着手せずに回すための道具。

GitHub の REST API だけを使う(`gh api` 経由。Claude Code on the web のプロキシでは GraphQL が使えないため)。
このツールはマージしない。マージ可否は「技術的な判定」として出すだけで、正式な承認と実際のマージは
人(または別途権限を与えた実行者)が行う。

  担当(Issue 単位。識別子は refs/agent-claims/issue-<番号>。ブランチ名とは別)
    eligible [--json]                         着手できる Issue
    deps <issue|pr>                           依存 Issue / PR の状態
    claim <issue> --agent NAME [--slug S] [--session URL] [--resume | --takeover | --adopt BRANCH] [--force]
                                              担当を確保して feature/<番号>-<slug> を作る(成功は1つだけ)
    claim-status <issue>                      確保の状態・止まっているか
    claim-renew <issue> | --mine              確保のリース(時刻)を更新する。確保したのと同じセッションからだけ
                                              (hook が AGENT_CLAIM_LEASE_MINUTES の 1/3 ごとに裏で --mine を呼ぶ)
    release <issue> --agent NAME [--force] [--handoff]
                                              確保を外す(ブランチは消さない)。--handoff は同じ agent 名の別セッションへ明示的に渡す
  PR
    pr-create --issue N --branch B --title T [--agent A] [--session S] [--body-file F] [--no-draft]
  レビュー(Opus 5.5 が別セッションで行う)
    review-start <pr>                         レビューする SHA を固定する(出力の SHA を読む)
    review-post <pr> --sha SHA --verdict pass|changes|blocked --blocking N --body-file F [--unverified 項目]...
                                              投稿直前に HEAD を確かめ、変わっていれば投稿しない(終了コード 6)
    human-confirm <pr> --sha SHA --items model,session --key K --principal P [--note T]
                                              本人がモデル・独立性を確かめた記録(本人の端末で、本人の鍵で署名)
  判定
    merge-gate <pr> [--json]                  マージ可否の技術判定(マージはしない)
    ci-policy [--base B]                      必須 CI の現状(ci-policy.json を作る手掛かり)
    labels [--apply]                          使うラベルの一覧 / 作成

終了コード: 0 成功 / 1 判定が不可 / 2 前提を満たさない / 3 他が確保済み・競合 / 4 モデル・独立性の問題 /
            5 GitHub API エラー / 6 レビュー中に PR が更新された
設定
  判定に使うもの(review-post・merge-gate)は、ベースブランチの .agent-kit/config.env を API で読む(PR が変えられない。
  環境変数でも上書きしない): AGENT_REVIEW_MODEL, AGENT_ALLOW_NO_CI, AGENT_REVIEWER_LOGINS, AGENT_GIT_EMAIL_CODEX。
  ベースブランチの .agent-kit/ci-policy.json・human-confirm-allowed-signers も同じ。
  それ以外(環境変数 > 手元の .agent-kit/config.env): AGENT_CLAIM_STALE_HOURS, AGENT_CLAIM_LEASE_MINUTES, AGENT_CLAIM_REF_PREFIX
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from agentgh import claims, gate, issues, review  # noqa: E402
from agentgh.api import ApiError, api, repo_slug, warn_on_error  # noqa: E402

LABELS = {
    "agent:ready": ("0e8a16", "エージェントが着手してよい(受入条件まで書かれている)"),
    "agent:claimed": ("fbca04", "担当確保済み(表示用。正本は refs/agent-claims)"),
    "agent:blocked": ("b60205", "依存待ち・判断待ちで着手できない"),
    "agent:stack-ok": ("c5def5", "前提 PR が未マージでも、その上に積んで着手してよい"),
    "agent:wip": ("ededed", "実装中(draft PR が使えないリポジトリ用)"),
    "agent:needs-review": ("1d76db", "実装完了。別セッションのレビュー待ち"),
    "agent:changes-requested": ("d93f0b", "レビューで修正が必要"),
    "agent:review-passed": ("5319e7", "最新コミットのレビューと必須 CI を通過(技術的にマージ可)。マージは人が行う"),
    "source:grokbot": ("bfdadc", "GrokBot が作成した Issue"),
}


def cmd_eligible(a, repo):
    items = api("GET", f"repos/{repo}/issues?state=open&labels=agent:ready&per_page=100", paginate=True) or []
    rows = [issues.evaluate_issue(repo, it, claims.read_claim(repo, it["number"]))
            for it in items if "pull_request" not in it]
    if a.json:
        print(json.dumps(rows, ensure_ascii=False, indent=2))
        return 0
    for r in rows:
        extra = f"(stack on {r['stack_on']})" if r["stack_on"] else ""
        tail = "" if r["eligible"] else " / " + "; ".join(r["reasons"])
        print(f"{'OK ' if r['eligible'] else '-- '}#{r['number']} {r['title']} {extra}{tail}")
    return 0


def cmd_deps(a, repo):
    it = api("GET", f"repos/{repo}/issues/{a.number}")
    refs = issues.dep_refs(repo, it.get("body") or "")
    if not refs:
        print("依存なし")
    bad = 0
    for r, n in refs:
        ok, msg, _ = issues.dep_status(r, n)
        bad += 0 if ok else 1
        print(("OK  " if ok else "NG  ") + msg)
    return 0 if bad == 0 else 1


def cmd_claim(a, repo):
    return claims.cmd_claim(a, repo, a.evidence)


def cmd_pr_create(a, repo):
    it = api("GET", f"repos/{repo}/issues/{a.issue}")
    deps = issues.dep_refs(repo, it.get("body") or "")
    claim = claims.read_claim(repo, a.issue) or {}
    if claim.get("state") != "claimed" or claim.get("branch") != a.branch:
        print(f"注: #{a.issue} の確保({claim.get('state', 'なし')} / {claim.get('branch')})と --branch が合わない", file=sys.stderr)
    base = claim.get("base") if claim.get("branch") == a.branch else api("GET", f"repos/{repo}")["default_branch"]
    ev = a.evidence
    impl = {"agent": a.agent, "session": a.session or "", "issue": a.issue,
            "hook_session_id": ev.get("hook_session_id", ""), "remote_session_id": ev.get("remote_session_id", ""),
            "at": claims._now().isoformat(timespec="seconds")}
    extra = Path(a.body_file).read_text(encoding="utf-8") if a.body_file else ""
    dep_lines = "\n".join(f"- {r}#{n}" if r != repo else f"- #{n}" for r, n in deps) or "- なし"
    body = f"Closes #{a.issue}\n\n### 依存\n{dep_lines}\n\n{extra}\n\n{issues.mark('impl', impl)}"
    payload = {"title": a.title, "head": a.branch, "base": base, "body": body, "draft": not a.no_draft}
    try:
        pr = api("POST", f"repos/{repo}/pulls", payload)
    except ApiError as e:
        if not (payload["draft"] and e.status == 422 and "draft" in str(e).lower()):
            raise
        payload.update(draft=False, title="[WIP] " + a.title)
        pr = api("POST", f"repos/{repo}/pulls", payload)
        warn_on_error(lambda: api("POST", f"repos/{repo}/issues/{pr['number']}/labels", {"labels": ["agent:wip"]}))
        print("注: このリポジトリでは draft PR が使えないため、通常の PR + agent:wip にした", file=sys.stderr)
    print(pr["html_url"])
    return 0


def cmd_labels(a, repo):
    for name, (color, desc) in LABELS.items():
        if not a.apply:
            print(f"{name}\t#{color}\t{desc}")
            continue
        try:
            api("POST", f"repos/{repo}/labels", {"name": name, "color": color, "description": desc})
            print(f"created: {name}")
        except ApiError as e:
            print(f"skip: {name} ({'既にある' if e.status == 422 else e})")
    return 0


def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--repo")
    sp = ap.add_subparsers(dest="cmd", required=True)

    def sub(name, fn):
        p = sp.add_parser(name)
        p.set_defaults(fn=fn)
        return p

    p = sub("eligible", cmd_eligible); p.add_argument("--json", action="store_true")
    p = sub("deps", cmd_deps); p.add_argument("number", type=int)
    p = sub("claim", cmd_claim); p.add_argument("number", type=int); p.add_argument("--agent", required=True)
    p.add_argument("--slug"); p.add_argument("--session"); p.add_argument("--force", action="store_true")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--resume", action="store_true"); g.add_argument("--takeover", action="store_true"); g.add_argument("--adopt")
    p = sub("claim-status", lambda a, r: claims.cmd_status(a, r)); p.add_argument("number", type=int)
    p = sub("claim-renew", lambda a, r: claims.cmd_renew(a, r, a.evidence)); p.add_argument("number", type=int, nargs="?")
    p.add_argument("--mine", action="store_true", help="このセッションが確保中の Issue すべて(hook が使う)")
    p = sub("release", lambda a, r: claims.cmd_release(a, r, a.evidence)); p.add_argument("number", type=int)
    p.add_argument("--agent", required=True); p.add_argument("--force", action="store_true")
    p.add_argument("--handoff", action="store_true", help="同じ agent 名の別のセッションに引き継ぐ(確保は残す)")
    p = sub("pr-create", cmd_pr_create); p.add_argument("--issue", type=int, required=True)
    p.add_argument("--branch", required=True); p.add_argument("--title", required=True)
    p.add_argument("--agent", default="unknown"); p.add_argument("--session"); p.add_argument("--body-file")
    p.add_argument("--no-draft", action="store_true")
    p = sub("review-start", lambda a, r: review.cmd_review_start(a, r)); p.add_argument("number", type=int)
    p = sub("review-post", lambda a, r: review.cmd_review_post(a, r)); p.add_argument("number", type=int)
    p.add_argument("--sha", required=True)
    p.add_argument("--verdict", choices=["pass", "changes", "blocked"], required=True)
    p.add_argument("--blocking", type=int, required=True); p.add_argument("--body-file", required=True)
    p.add_argument("--model", help="自己申告(記録はするが確認には使わない。指定と違えば中止)")
    p.add_argument("--unverified", action="append")
    p = sub("human-confirm", lambda a, r: review.cmd_human_confirm(a, r)); p.add_argument("number", type=int)
    p.add_argument("--sha", required=True); p.add_argument("--items", required=True); p.add_argument("--note")
    p.add_argument("--key", help="署名に使う鍵(秘密鍵、または ssh-agent の鍵の公開鍵ファイル)")
    p.add_argument("--principal", help="allowed-signers に書いた名前")
    p = sub("merge-gate", lambda a, r: gate.cmd_merge_gate(a, r)); p.add_argument("number", type=int)
    p.add_argument("--json", action="store_true")
    p = sub("ci-policy", lambda a, r: gate.cmd_ci_policy(a, r)); p.add_argument("--base")
    p = sub("labels", cmd_labels); p.add_argument("--apply", action="store_true")
    return ap


def main() -> int:
    a = build_parser().parse_args()
    a.evidence = review.own_evidence(sys.argv[1:])     # hook が残した「このコマンドを出したセッション」
    try:
        return a.fn(a, repo_slug(a.repo))
    except ApiError as e:
        print(f"GitHub API エラー: {e}", file=sys.stderr)
        return 5
    except Exception as e:      # 予期しない失敗でも「合格」にはしない(merge-gate は終了コード 1 = 不可)
        print(f"予期しない失敗: {type(e).__name__}: {e}(判定は不可として扱う)", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
